{
  "cleanUrls": true,
  "functions": { "api/npc.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/npc?__p=:path*" }],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
